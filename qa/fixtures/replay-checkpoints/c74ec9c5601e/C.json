{"version": 1, "name": "SAVE\\SAVGAMC.DAT", "data": "", "leads": [{"id": "council-commissions", "title": "Council commissions", "detail": "Rolf says to read the proclamations at City Hall and ask the clerk about commissions."}, {"id": "phlan-training-schools", "title": "Training in New Phlan", "detail": "Rolf showed the party where adventurers train. Return to the training schools when a character is ready to advance."}, {"id": "harbor-trade", "title": "The sea lanes", "detail": "Rolf says few ships risk the passage and the council wants to reopen it."}, {"id": "proclamation-lxiv", "title": "Proclamation LXIV", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "proclamation-lxxviii", "title": "Proclamation LXXVIII", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "proclamation-cix", "title": "Proclamation CIX", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "proclamation-lix", "title": "Proclamation LIX", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "commission-ohlo", "title": "Fetch Ohlo's potion - turned in", "detail": "Ohlo drank his potion and settled the reward.", "status": "turned-in"}, {"id": "ohlo-rope-guild-entry", "title": "The Rope Guild entrance", "detail": "The party found the notice just north of the entrance to the Old Rope Guild."}, {"id": "ohlo-rope-guild", "title": "The Old Rope Guild", "detail": "The party entered the former Rope Guild in the Slums."}, {"id": "ohlo-booth", "title": "The Rope Guild booth", "detail": "The man in the booth says he has nothing to sell."}, {"id": "ohlo-delivered", "title": "Ohlo drank the potion", "detail": "Ohlo drank the potion, grew younger, and offered the promised reward."}, {"id": "passage-sokal", "title": "Passage to Sokal Keep", "detail": "The harbor master says you can reach the keep by boat."}, {"id": "sokal-arrival", "title": "Arrival at Sokal Keep", "detail": "The party landed on Thorn Island."}, {"id": "commission-slums", "title": "Clear the Slums - in progress", "detail": "Keep clearing encounters in the Slums until the district is secure. 2 encounters cleared.", "status": "accepted", "clearedEncounters": 2}, {"id": "commission-sokal", "title": "Clear Sokal Keep - offered", "detail": "Find passage to Thorn Island, clear the keep, and report to the clerk.", "status": "offered"}, {"id": "commission-records", "title": "Recover records of old Phlan - offered", "detail": "Search the old city for historical records and bring worthwhile finds to the clerk.", "status": "offered"}, {"id": "sokal-reeds", "title": "Reeds by the keep gate", "detail": "The party saw a mound of reeds west of the gates."}, {"id": "sokal-parchment", "title": "The parchment at Sokal Keep", "detail": "The party found a damaged scroll on a dead elf outside the keep."}, {"id": "sokal-patrol-passed", "title": "Sokal Keep patrol", "detail": "The undead patrol accepted the word and let the party pass."}], "party": {"SAVE\\CHRDATC1.SAV": "", "SAVE\\CHRDATC1.ITM": "C0NoYWluIE1haWwgIE1haWwgICAgICAgICAgICA3NQAAAAAAAAAAAAAAAAAAADcAMDcAAAEAACwBAEsAAAAA", "SAVE\\CHRDATC1.SPC": "WgAA/wAAAIQ6YQAA/wAJAIQ6GgAA/wACAIU6LwAA/wAAAAAA", "SAVE\\CHRDATC2.SAV": "", "SAVE\\CHRDATC2.ITM": "CUhhbmQgQXhlIGQgQXhlICAgICAgICAgICAgICAgMQAAAAAAAAAAAAAABwCbOgIAAAIAAAEAADIAAAEAAAAAC0NoYWluIE1haWwgIE1haWwgICAgICAgICAgICA3NQAAAAAAAAAAAAAAAAAAADcAMDcAAAEAACwBAEsAAAAA", "SAVE\\CHRDATC2.SPC": "WgAA/wAPAJ86YQAA/wAIAKA6GgAA/wABAKE6LwAA/wAAAAAA", "SAVE\\CHRDATC3.SAV": "", "SAVE\\CHRDATC3.ITM": "C0NoYWluIE1haWwgIE1haWwgICAgICAgICAgICA3NQAAAAAAAAAAAAAAAAAAADcAMDcAAAEAACwBAEsAAAAA", "SAVE\\CHRDATC3.SPC": "WgAA/wAPALc6YQAA/wAIALg6GgAA/wABALk6LwAA/wAAAAAA", "SAVE\\CHRDATC4.SAV": "", "SAVE\\CHRDATC4.ITM": "C0NoYWluIE1haWwgIE1haWwgICAgICAgICAgICA3NQAAAAAAAAAAAAAAAAAAADcAMDcAAAEAACwBAEsAAAAA", "SAVE\\CHRDATC4.SPC