{"version": 1, "name": "SAVE\\SAVGAMA.DAT", "data": "", "leads": [{"id": "council-commissions", "title": "Council commissions", "detail": "Rolf says to read the proclamations at City Hall and ask the clerk about commissions."}, {"id": "phlan-training-schools", "title": "Training in New Phlan", "detail": "Rolf showed the party where adventurers train. Return to the training schools when a character is ready to advance."}, {"id": "harbor-trade", "title": "The sea lanes", "detail": "Rolf says few ships risk the passage and the council wants to reopen it."}, {"id": "proclamation-lxiv", "title": "Proclamation LXIV", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "proclamation-lxxviii", "title": "Proclamation LXXVIII", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "proclamation-cix", "title": "Proclamation CIX", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "proclamation-lix", "title": "Proclamation LIX", "detail": "The party recorded this council proclamation. Its text is in the Adventurer's Journal."}, {"id": "passage-sokal", "title": "Passage to Sokal Keep", "detail": "The harbor master says you can reach the keep by boat."}, {"id": "sokal-arrival", "title": "Arrival at Sokal Keep", "detail": "The party landed on Thorn Island."}, {"id": "commission-slums", "title": "Clear the Slums - in progress", "detail": "Keep clearing encounters in the Slums until the district is secure. 1 encounter cleared.", "status": "accepted", "clearedEncounters": 1}, {"id": "commission-sokal", "title": "Clear Sokal Keep - turned in", "detail": "The council acknowledged the result.", "status": "turned-in"}, {"id": "commission-records", "title": "Recover records of old Phlan - offered", "detail": "Search the old city for historical records and bring worthwhile finds to the clerk.", "status": "offered"}, {"id": "sokal-ferran", "title": "Ferran Martinez", "detail": "Ferran is bound to guard the keep and asks whether Phlan has been freed."}, {"id": "sokal-pale-form", "title": "The keep's pale figure", "detail": "A pale figure appeared inside the keep. The party can try speaking to it."}, {"id": "sokal-mendor", "title": "Mendor's lost histories", "detail": "Ferran says Mendor gathered accounts of the powers that brought down Phlan. His library was overrun."}, {"id": "sokal-armory", "title": "Sokal Keep armory", "detail": "Ferran says help lies beyond an illusory wall in the armory."}, {"id": "sokal-departure", "title": "Ferran's password", "detail": "Ferran told the party to say SAMOSUD to his guards on the way out."}, {"id": "commission-auction", "title": "Investigate the auction - ready to report", "detail": "Return to the council clerk at City Hall to report your success.", "status": "ready-to-report"}, {"id": "harbor-routes-reopened", "title": "The harbor routes are open", "detail": "The harbor master offers passage east, west, back to Sokal Keep, and to the north side of the bay."}, {"id": "auction-exchange", "title": "The auction exchange", "detail": "The party saw a man and an ogre exchange the wand and a large bag before disappearing into the crowd."}, {"id": "zhentil-envoy-challenge", "title": "Zhentil's mounted patrol", "detail": "The mounted patrol asked if the party was New Phlan's diplomatic delegation."}, {"id": "zhentil-packet-delivered", "title": "The commandant received the packet", "detail": "The party handed the papers to the commandant inside his office."}, {"id": "zhentil-quarters", "title": "Quarters at Zhentil Outpost", "detail": "The guard showed the party its assigned quarters and told it to stay there."}], "party": {"SAVE\\CHRDATA1.SAV": "", "SAVE\\CHRDATA1.ITM": "CUhhbmQgQXhlIGQgQXhlICAgICAgICAgICAgICAgMQAAAAAAAAAAAAAABwCDOgIAAAIAAAEAADIAAAEAAAAAC0NoYWluIE1haWwgIE1haWwgICAgICAgICAgICA3NQAAAAAAAAAAAAAAAAAAADcAMDcAAAEAACwBAEsAAAAA", "SAVE\\CHRDATA1.SPC"