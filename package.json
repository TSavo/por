{
  "name": "pool-of-radiance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Port of SSI Pool of Radiance: Turbo Pascal procedures translated from START.EXE and GAME.OVR, plus a classic/upgraded presentation.",
  "scripts": {
    "dev": "npm run play",
    "play": "tsx tools/browser-play.ts",
    "verify:campaign": "node tools/verify-fresh-party.mjs --campaign",
    "verify:campaign-opening": "node tools/verify-fresh-party.mjs --campaign-opening",
    "verify:map-journal": "node tools/verify-map-journal.mjs",
    "verify:input": "node tools/verify-input.mjs",
    "code-wheel": "python3 tools/build-code-wheel.py",
    "verify:code-wheel": "python3 tools/build-code-wheel.py --check",
    "qa:inventory": "tsx tools/qa-inventory.ts",
    "qa:version-1.3": "tsx tools/qa-version-1.3.ts",
    "preview:new-phlan": "tsx tools/new-phlan-3d-prototype.ts",
    "typecheck": "tsc --noEmit",
    "tools": "tsx tools/cli.ts",
    "selftest": "tsx tools/cli.ts selftest",
    "shots": "tsx tools/cli.ts shots",
    "sound-inventory": "tsx tools/sound-inventory.ts",
    "sound-driver-data": "tsx tools/sound-driver-data.ts",
    "render-original-sounds": "tsx tools/render-original-sounds.ts",
    "audio-coverage": "tsx tools/audio-coverage.ts",
    "audio-system-coverage": "tsx tools/audio-system-coverage.ts",
    "area-catalog": "tsx tools/extract-area-catalog.ts",
    "generate-enhanced-audio": "tsx tools/generate-enhanced-audio.ts",
    "generate-narrator-previews": "tsx tools/generate-narrator-previews.ts",
    "select-narrator-voice": "tsx tools/select-narrator-voice.ts",
    "generate-narrator-anchor": "tsx tools/generate-narrator-anchor.ts",
    "voice-inventory": "tsx tools/voice-inventory.ts",
    "voice-review-extraction": "tsx tools/voice-review-extraction.ts",
    "verify-narration-generation": "tsx tools/verify-narration-generation.ts",
    "verify-narration-runtime": "tsx tools/verify-narration-runtime.ts",
    "voice-master-manifest": "tsx tools/build-master-voice-manifest.ts",
    "verify-voice-master": "tsx tools/verify-master-voice-manifest.ts",
    "compile-fish-prompts": "tsx tools/compile-fish-prompts.ts",
    "voice-dispositions": "tsx tools/voice-dispositions.ts",
    "voice-coverage": "tsx tools/voice-coverage.ts",
    "translate": "python tools/tp_translate.py",
    "verify:translation-reproducible": "python tools/tp_translate.py --check",
    "translate:1.3": "python tools/tp_translate.py ../por-assets/gog-1.3/POOLRAD --game-version 1.3",
    "verify:translation-reproducible:1.3": "python tools/tp_translate.py ../por-assets/gog-1.3/POOLRAD --game-version 1.3 --check",
    "verify": "tsx tools/verify-translation-coverage.ts && tsx tools/verify-translation.ts && tsx tools/verify-automap.ts && node tools/verify-input.mjs && tsx tools/verify-original-audio.ts && tsx tools/verify-enhanced-audio.ts && tsx tools/verify-voice.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
