{
  "schema": 1,
  "model": "eleven_v4",
  "sourceReview": "src/audio/ecl1-voice-review.json",
  "items": [
    {
      "unitId": "ecl1-b18-9c54",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9c54"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9c54.mp3",
      "text": "THEY YELL 'SETTLERS! KILL THEM!'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9c85",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9c85"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9c85.mp3",
      "text": "'OH, YOU'RE HERE FOR THE BOSS.'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9cba",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9cba"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9cba.mp3",
      "text": "THEY GRUMBLE AND MOVE ON.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9d37",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9d37"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9d37.mp3",
      "text": "YOUR PARTY SLIPS PAST THEM.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9d53",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9d53"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9d53.mp3",
      "text": "YOU STOP, AND THEY MOVE ON.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9e23",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9e23"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9e23.mp3",
      "text": "THE PARTY RUNS AND ESCAPES.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9e82",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9e82"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9e82.mp3",
      "text": "YOUR COVER IS BLOWN.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9ef8",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9ef8"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9ef8.mp3",
      "text": "'WE'LL LET YOU OFF THIS TIME.' THE MONSTERS SCUTTLE AWAY.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9f35",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9f35"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9f35.mp3",
      "text": "'MOVE IT, TROLL-BAIT!' THEY SNARL AND MOVE OFF.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9f60",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9f60"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9f60.mp3",
      "text": "'WE'RE GONNA HAVE TA TEACH YOU A LESSON!'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a2b4",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a2b4"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a2b4.mp3",
      "text": "THE AUCTIONEER CRIES 'CREATURES OF ALL AGES, WELCOME TO THIS AUCTION FOR AN ITEM BOTH MAGICAL AND POWERFUL!'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a30c",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a30c"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a30c.mp3",
      "text": "THE AUCTIONEER HAS EITHER A WAND OR STAFF.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a38a",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a38a"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a38a.mp3",
      "text": "THE BIDDING ESCALATES TO 5,000 GOLD PIECES -- HIGH BID FROM A MAN IN PLAIN CLOTHES, NEXT TO AN OGRE.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a459",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a459"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a459.mp3",
      "text": "THE MAN THEN SPEAKS A WORD AND THE AUCTIONEER'S BLOCK IS ENVELOPED IN DARKNESS.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a49c",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a49c"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a49c.mp3",
      "text": "THERE IS MASS CONFUSION. SUDDENLY, THE OGRE SPRINTS FROM THE DARKNESS.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a52d",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a52d"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a52d.mp3",
      "text": "THE OGRE IS TACKLED AND SEARCHED. HE DOESN'T HAVE THE ITEM ON HIM.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a5c0",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a5c0"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a5c0.mp3",
      "text": "'GARWIN, I'LL GET YOU!' CRIES THE AUCTIONEER. HOWEVER, THE MAN HAS ESCAPED IN THE CONFUSION.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a60c",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a60c"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a60c.mp3",
      "text": "'GOING... GOING... GONE!' THE AUCTIONEER CRIES.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a637",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a637"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a637.mp3",
      "text": "A MAN AND OGRE EXCHANGE THE WAND AND A LARGE BAG, THEN DISAPPEAR INTO THE CROWD.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a6b4",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a6b4"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a6b4.mp3",
      "text": "THE AUCTION ENDS. YOU DON'T SEE WHO BOUGHT THE ITEM.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a713",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a713"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a713.mp3",
      "text": "YOU NOW SEE THE WAND ISN'T A MAJOR ARTIFACT, IT'S ONLY A WAND OF FEAR!",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a761",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a761"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a761.mp3",
      "text": "'IT'S A WAND OF ILLUMINATION. WHO CARES, I SEE IN THE DARK ANYWAY!'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a79f",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a79f"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a79f.mp3",
      "text": "'IT'S A STAFF OF COMMAND. I COULD HAVE MY OWN ARMY!'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a7f0",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a7f0"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a7f0.mp3",
      "text": "'THE AUCTION IS CANCELLED!' YELLS THE AUCTIONEER AS HE FLEES.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a839",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a839"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a839.mp3",
      "text": "THE AUCTION OVER, THE MONSTERS GRUMBLE AND TURN AWAY.'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a9ac",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a9ac"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a9ac.mp3",
      "text": "THAT ONE IS UNACCEPTABLE. CHOOSE ANOTHER.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a9f0",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a9f0"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a9f0.mp3",
      "text": "THE BATTLE IS OVER, THE PATRONS RETURN TO DRINKING.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-aa28",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-aa28"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-aa28.mp3",
      "text": "THE BUCCANEER SMILES.'THAT IS SUFFICIENT PAYMENT.' HE LEAVES.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-aa6a",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-aa6a"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-aa6a.mp3",
      "text": "YOUR ACTIONS ANGER THE PATRONS AND THEY ATTACK.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-aad0",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-aad0"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-aad0.mp3",
      "text": "'A TENTH OF YOUR MONEY THEN.'DO YOU ACCEPT?",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-ab2c",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-ab2c"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-ab2c.mp3",
      "text": "THE CREATURES IGNORE YOU FOR THE MOMENT.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-abb5",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-abb5"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-abb5.mp3",
      "text": "MONSTERS INSULT YOUR ABILITIES AND PARENTAGE.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-ac57",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-ac57"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-ac57.mp3",
      "text": "YOU HAD A GREAT TIME UNTIL YOU ALL PASSED OUT. YOUR PURSE IS MISSING.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-acaf",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-acaf"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-acaf.mp3",
      "text": "YOUR ACTIONS TRIGGER A FREE FOR ALL.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-ad4d",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-ad4d"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-ad4d.mp3",
      "text": "THE BAR LOOKS LIKE IT WAS DESTROYED BY EXPERTS.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-ad81",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-ad81"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-ad81.mp3",
      "text": "OVER THIS DOOR IS A CRUDE SIGN SAYING, 'THE PITT.'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-adb6",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-adb6"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-adb6.mp3",
      "text": "THIS IS A HIDDEN TEMPLE OF ILMATER. YOU FEEL SAFE HERE.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-adec",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-adec"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-adec.mp3",
      "text": "A YOUNG WOMAN COMES FORWARD 'WE PROVIDE HELP FOR THOSE WHO CAN REACH US. ARE YOU IN NEED OF HEALING?",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-ae5d",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-ae5d"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-ae5d.mp3",
      "text": "'YOU CAN REST HERE AS LONG AS YOU WISH.' SHE THEN LEAVES.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-aea1",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-aea1"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-aea1.mp3",
      "text": "THIS IS A SMALL SHRINE. SYMBOLS OF BANE HAVE REPLACED THOSE OF ILMATER.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-aeed",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-aeed"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-aeed.mp3",
      "text": "A ROBED ORC IS SITTING HERE. WHAT DO YOU DO?",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-b016",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-b016"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-b016.mp3",
      "text": "'MEET HERE IN TWO HOURS. YOU MAY MEET HIGH PRIEST MACE.' HE ESCORTS YOU OUT.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-b07c",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-b07c"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-b07c.mp3",
      "text": "'IF YOU CHANGE YOUR MIND, RETURN IN TWO HOURS.' HE ESCORTS YOU OUT.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-b0ce",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-b0ce"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-b0ce.mp3",
      "text": "MANY CREATURES HAVE GATHERED. THE ROBED ORC STANDS AND CALLS OUT,'FIRST, TO SHOW YOUR LOYALTIES, KILL THE UNBELIEVERS.' HE POINTS AT YOUR GROUP.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-b1c3",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-b1c3"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-b1c3.mp3",
      "text": "AN ABANDONED SHOP. BROKEN SHELVES ARE ALL THAT REMAIN.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-b1fb",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-b1fb"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-b1fb.mp3",
      "text": "A DECAYED BUILDING LEFT TO THE RATS.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9a36-prompt",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9a36"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9a36-prompt.mp3",
      "text": "THE PLAZA AHEAD IS CROWDED WITH MONSTERS. HOW WILL YOU PROCEDE?",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9d86-ready",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9d86"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9d86-ready.mp3",
      "text": "THE MONSTERS STAND READY",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9d86-prepare",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9d86"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9d86-prepare.mp3",
      "text": "THE MONSTERS PREPARE",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-a90d-story",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-a90d"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-a90d-story.mp3",
      "text": "HE GLARES AT YOU,'ONE OF YOU SHALL PAY FOR THIS INSULT. WHO WILL IT BE?'",
      "direction": "tense fantasy narration; perform the drunk buccaneer's challenge with offended menace",
      "performedCharacterId": "drunk-buccaneer"
    },
    {
      "unitId": "ecl1-b18-9b9a-9c19",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9b9a",
        "por.review.ecl-1.block-18.at-9c19"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9b9a-9c19.mp3",
      "text": "THEY GLARE AT YOUR PARTY, AND DEMAND, 'WHO ARE YOU?'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9b9a-9ce6",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9b9a",
        "por.review.ecl-1.block-18.at-9ce6"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9b9a-9ce6.mp3",
      "text": "THEY GLARE AT YOUR PARTY, AND WALK ON.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9b9a-9cf6",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9b9a",
        "por.review.ecl-1.block-18.at-9cf6"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9b9a-9cf6.mp3",
      "text": "THEY GLARE AT YOUR PARTY, LAUGH TO THEMSELVES AND WALK ON.",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9bb5-9c19",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9bb5",
        "por.review.ecl-1.block-18.at-9c19"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9bb5-9c19.mp3",
      "text": "THEY CHECK OUT YOUR PARTY, AND DEMAND, 'WHO ARE YOU?'",
      "direction": "measured dramatic fantasy narration",
      "performedCharacterId": null
    },
    {
      "unitId": "ecl1-b18-9bb5-9ce6",
      "sourceIds": [
        "por.review.ecl-1.block-18.at-9bb5",
        "por.review.ecl-1.block-18.at-9ce6"
      ],
      "output": "audio/voices/narration/ecl1/block-18/ecl1-b18-9bb5-9ce6.mp3",
